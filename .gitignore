# environnement et données lourdes (téléchargées par setup.py)
# venv : dossier, ou lien vers celui du dossier principal dans un worktree (tests/check.py --link-venv)
/venv
models/
sdcpp/
*.part
*.sha256ok
*.corrompu

# productions et journaux personnels
outputs/
jobs/
# espace privé : clés et images chiffrées
/private/
logs/
tests/bench_*.png

# fichiers générés localement
Chambre noire.lnk
Qwen-Image.lnk
__pycache__/
*.pyc
tools/download*.log
tools/hf_*.json
tools/hf_README.md
tools/sdcpp_release.json

# mesures de vitesse et réglages propres à chaque machine
tools/calibration.json
tools/config.local.json

# raccourci macOS généré par setup.py
Chambre noire.command
Qwen-Image.command

# code d'accès des appareils du Wi-Fi (launch.py --lan)
tools/access_code.txt
# notifications : clé d'envoi de la machine et appareils abonnés
tools/push_vapid.pem
tools/push_subscriptions.json
# prompts enregistrés de l'utilisateur (et le fichier temporaire de leur écriture)
tools/saved_prompts.json
tools/saved_prompts.json.tmp
# fichiers du Finder
.DS_Store

# worktrees de travail
.claude/worktrees/
# notes de travail locales (gardées sur le disque, hors du dépôt public)
/CLAUDE.md
/ETAT_DU_PROJET.md
/travail
/docs/specs
/docs/agents/*
!/docs/agents/carte-du-code.md
