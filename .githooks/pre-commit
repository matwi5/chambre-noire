#!/bin/sh
# Hook avant commit, versionné : refuse un commit qui ajoute depuis la base (git merge-base HEAD origin/main) une
# ligne de plus de 120 caractères dans un .py, .md, .mjs ou .js (tests/check.py --lines --cached, sur l'index, en
# moins d'une seconde) : la faute se voit au commit, pas au bout du contrôle complet ni en CI.
# Activé par « python3 tests/check.py --link-venv » (git config core.hooksPath .githooks).
for py in venv/bin/python venv/Scripts/python.exe python3 python; do
  # un Python qui ne démarre pas (alias du Microsoft Store sous Windows) est sauté
  if { [ -x "$py" ] || command -v "$py" >/dev/null 2>&1; } && "$py" -c '' >/dev/null 2>&1; then
    exec "$py" tests/check.py --lines --cached
  fi
done
echo "pre-commit : aucun Python trouvé, longueur des lignes non vérifiée" >&2
